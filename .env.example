# Copy this file to .env and fill it in to put the books behind a login.
# Without a login the app only answers on this computer.
BOOKS_USER=
BOOKS_PASSWORD=
# Any long random text. Keeps people logged in when the server restarts.
BOOKS_SESSION_SECRET=
# Set to 0.0.0.0 to let other computers on the network (or a tunnel) reach it. Needs the login above.
# HOST=0.0.0.0
# Your free fixed ngrok address, used by start-online.bat (for example: apex-books.ngrok-free.app)
NGROK_DOMAIN=
